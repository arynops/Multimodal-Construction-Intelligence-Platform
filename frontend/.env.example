# ═══════════════════════════════════════════════════════════════
#  ConstructAI — Frontend Environment Configuration
#  Copy this file to .env and fill in your real values.
#  Variables MUST be prefixed with VITE_ to be exposed to the
#  browser bundle by Vite's import.meta.env mechanism.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Backend API ───────────────────────────────────────────────
# Full base URL of the FastAPI backend (no trailing slash).
# In development the Vite proxy rewrites /api → backend, so you
# can leave this as an empty string or point to the backend directly.
# In production set this to your deployed API domain, e.g.:
#   VITE_API_BASE_URL=https://api.constructai.example.com
VITE_API_BASE_URL=http://localhost:8000

# ─── App Meta ──────────────────────────────────────────────────
# Displayed in the browser tab and meta tags.
VITE_APP_NAME=ConstructAI
VITE_APP_VERSION=1.0.0

# ─── Feature Flags ─────────────────────────────────────────────
# Set to "true" to enable experimental modules in development.
VITE_ENABLE_DEV_TOOLS=true
